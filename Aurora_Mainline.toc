# This TOC serves retail (game type "standard") AND WoW Forever (game type
# "camelot"): the Forever client also matches _Mainline.toc, so the two
# flavors are split per line with load directives instead of separate TOCs.
# The Forever-only lines carry the extra Exclude because clients that do not
# know the camelot token treat an unknown AllowLoadGameType as a match.

libs\Libs.xml
Skin\skin.xml
Skin\Interface\AddOns\AddOns_Mainline.xml [AllowLoadGameType standard]
Skin\Interface\AddOns\AddOns_Forever.xml [AllowLoadGameType camelot][ExcludeLoadGameType standard, classic]

config.lua
analytics.lua
compatibility.lua
integration.lua
aurora.lua
gui.lua

#@do-not-package@
dev\test.lua
#@end-do-not-package@
